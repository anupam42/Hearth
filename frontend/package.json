{
  "name": "hearth-frontend",
  "version": "0.1.0",
  "description": "Framework-free TypeScript SPA for Hearth — hand-built signal-based reactivity and hyperscript DOM builder, zero runtime dependencies.",
  "keywords": [
    "typescript",
    "spa",
    "no-framework",
    "vanilla-typescript",
    "zero-dependency",
    "reactive",
    "hyperscript"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "watch": "tsc --watch",
    "serve": "node scripts/dev-server.js",
    "dev": "node scripts/dev-server.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.68.0"
  }
}
