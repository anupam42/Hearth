#!/usr/bin/env bash
# Runs ESLint over staged frontend/src changes before allowing a commit.
# Installed into .git/hooks/pre-commit — see README for setup on a fresh clone.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

staged_frontend_ts=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^frontend/src/.*\.tsx?$' || true)

if [ -z "$staged_frontend_ts" ]; then
  exit 0
fi

echo "Running ESLint on staged frontend changes..."
cd frontend
if ! npm run --silent lint; then
  echo
  echo "ESLint failed — fix the issues above, or run 'npm run lint:fix' in frontend/, before committing."
  exit 1
fi
